{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "broadcast/**",
    "cache/**",
    "node_modules/**",
    "out/**",
    "reports/**",
    "ui/dist/**",
    "vendor/**"
